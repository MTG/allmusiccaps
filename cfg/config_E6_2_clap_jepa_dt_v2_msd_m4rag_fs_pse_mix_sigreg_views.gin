# E6.2: ClapJepa trained on DT v2 (structured) + MSD + M4-RAG + Freesound + PSE
# Same clap_jepa config as E6.1 (mix_sigreg_views=True) but with DT v2 instead of v1
# Measures the impact of using the structured version of DT (v2)
# Music datasets (DT v2, MSD, M4-RAG) = 80%, Sound datasets (FS, PSE) = 20%
#
# Dataset sizes: DT v2 = 540442, MSD = 403803, M4-RAG = 243084, FS = 286083, PSE = 709536
# Ratios are inversely proportional to dataset size within each group (music 80%, sound 20%)
# Balanced ratios: [0.18, 0.23, 0.39, 0.14, 0.06]

include "cfg/config_clap_mpnet_base_v2_ssl_mp_10s_small_clap_dt_structured_msd_fs_pse_lr_5e-6.gin"

# Override module
def_module.module = @clap_jepa

# ClapJepa model settings (baseline CLAP params + JEPA params)
ClapJepa.aggregation_type = 'mean'
ClapJepa.audio_encoder = @OMARRQ
ClapJepa.text_encoder = @AllMPNetBaseV2
ClapJepa.lr = 5e-6
ClapJepa.n_pool_att_heads = 8
ClapJepa.proj_size = 512
ClapJepa.seed = 0
ClapJepa.temp = 0.1
ClapJepa.train_audio_encoder = True
ClapJepa.train_text_encoder = False
ClapJepa.weight_decay = 0.01
# JEPA params (from LeJEPA experiments)
ClapJepa.lambd = (0, 0.05)
ClapJepa.inv_loss_type = "info_nce_multimodal"
ClapJepa.n_slices = 2048
ClapJepa.n_points = 17
# Mixed-modality views for SIGReg loss
ClapJepa.mix_sigreg_views = True


# Full training: 2 nodes, 4 GPUs each
train.params = {
    'accelerator': 'gpu',
    'num_nodes': 2,
    'devices': 4,
    'log_every_n_steps': 50,
    'check_val_every_n_epoch': 4,
    'max_steps': 150000,
    'num_sanity_val_steps': 1,
    'precision': 'bf16-mixed',
    'strategy': 'ddp_find_unused_parameters_true',
}

# DT v2 datamodule settings
DiscotubeStructuredTextAudioDataModule.batch_size = %batch_size
DiscotubeStructuredTextAudioDataModule.num_workers = 20
DiscotubeStructuredTextAudioDataModule.data_dir = "/scratch/<group>/mmaps_discotube/"
DiscotubeStructuredTextAudioDataModule.filelist_train =  "/scratch/<group>/discotube/metadata/llama33_promptv3_filelist_train"
DiscotubeStructuredTextAudioDataModule.filelist_val =  "/scratch/<group>/discotube/metadata/llama33_promptv3_filelist_val"
DiscotubeStructuredTextAudioDataModule.text_file = "/scratch/<group>/discotube/metadata/llama33_promptv3_captions.jsonl"
DiscotubeStructuredTextAudioDataModule.p = 0.2
DiscotubeStructuredTextAudioDataset.use_audio_type_token = True
DiscotubeStructuredTextAudioDataset.audio_type_token_dropout = 0.2

# DT v2 dataset settings
DiscotubeStructuredTextAudioDataset.num_frames = 160000 # num frames @ original sr
DiscotubeStructuredTextAudioDataset.folder_structure_type = "bsc"

# M4-RAG datamodule settings
M4RAGTextAudioDataModule.batch_size = %batch_size
M4RAGTextAudioDataModule.data_dir = "/scratch/<group>/mmaps_discotube/"
M4RAGTextAudioDataModule.filelist_train = "/scratch/<group>/discotube/metadata/m4rag_splits/filelist_train.txt"
M4RAGTextAudioDataModule.filelist_val = "/scratch/<group>/discotube/metadata/m4rag_splits/filelist_val.txt"
M4RAGTextAudioDataModule.metadata_file = "/scratch/<group>/discotube/metadata/m4rag_splits/m4rag_metadata.jsonl"
M4RAGTextAudioDataModule.num_workers = 20
M4RAGTextAudioDataModule.text_fields = ["description", "background", "analysis", "scene"]

# M4RAG dataset settings
M4RAGTextAudioDataset.num_frames = 160000
M4RAGTextAudioDataset.use_audio_type_token = True
M4RAGTextAudioDataset.audio_type_token_dropout = 0.2

# ConcatTextAudioDataModule: DT v2 (structured) + MSD + M4-RAG + FS + PSE
ConcatTextAudioDataModule.datamodules = [
  @DiscotubeStructuredTextAudioDataModule,
  @MSDTextAudioDataModule,
  @M4RAGTextAudioDataModule,
  @FreesoundTextAudioDataModule,
  @PSETextAudioDataModule,
]

# Music=80% (inverse size: DT v2 < MSD < M4-RAG), Sound=20% (inverse size: PSE < FS)
ConcatTextAudioDataModule.ratios = [0.18, 0.23, 0.39, 0.14, 0.06]

# Layer-wise geometric metrics
train.layerwise_metrics = True

train.wandb_params = {
    "entity": "<anon-entity>",
    "group": "clap_jepa_experiments",
    "name": "E6_2_clap_jepa_dt_v2_msd_m4rag_fs_pse_mix_sigreg_views",
    "offline": True,
    "project": "text-audio",
    "save_dir": "/projects/<group>/logs/",
}
