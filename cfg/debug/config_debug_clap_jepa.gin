# Local debug configuration for ClapJepa training
# Runs on CPU with dummy data, no external files required

# Wandb settings - offline mode for local debugging
train.wandb_params = {
    "project": "text-audio",
    "name": "debug.clap_jepa",
    "offline": True,
    "save_dir": "./debug_logs/",
}

# Lightning trainer parameters - minimal CPU configuration
train.params = {
    "accelerator": "cpu",
    "devices": 1,
    "max_steps": 10,
    "log_every_n_steps": 1,
    "precision": "32-true",
}

# Use dummy datamodule (no external files needed)
train.datamodule = @dummy_text_audio

# Module configuration
def_module.module = @clap_jepa

# ClapJepa model settings
ClapJepa.audio_encoder = @OMARRQ
ClapJepa.text_encoder = @AllMPNetBaseV2
ClapJepa.proj_size = 512
ClapJepa.temp = 0.1
ClapJepa.lr = 1e-4
ClapJepa.weight_decay = 1e-2
ClapJepa.seed = 42
ClapJepa.train_audio_encoder = False
ClapJepa.train_text_encoder = False
ClapJepa.aggregation_type = "mean"
ClapJepa.inv_loss_type = "info_nce_multimodal"
ClapJepa.lambd = 0.02

# Encoder settings
OMARRQ.model_id = "mtg-upf/clap_omarrq_mp_small_music"
AllMPNetBaseV2.model_id = "sentence-transformers/all-mpnet-base-v2"

# Cosine annealing scheduler - short warmup for debug runs
CosineAnnealingCallback.warmup_steps = 2
CosineAnnealingCallback.eta_min = 1e-7

# Dummy datamodule parameters
DummyTextAudioDataModule.batch_size = 4
DummyTextAudioDataModule.num_workers = 0
DummyTextAudioDataModule.num_train_samples = 100
DummyTextAudioDataModule.num_val_samples = 20
DummyTextAudioDataModule.num_frames = 240000  # 10s at 24kHz
DummyTextAudioDataModule.sample_rate = 24000
DummyTextAudioDataModule.half_precision = False  # Use float32 for CPU

# Layer-wise geometric metrics (optional)
# train.layerwise_metrics = True
# LayerWiseMetricsCallback.num_samples = 512
# LayerWiseMetricsCallback.lid_k = 32
# LayerWiseMetricsCallback.num_gauss_directions = 256

# Information imbalance (audio layers vs text tower, optional)
# train.info_imbalance = True
# InformationImbalanceCallback.num_samples = 512
# InformationImbalanceCallback.k = 1
# InformationImbalanceCallback.maxk = 100
