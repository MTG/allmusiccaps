# Local debug configuration for LeJEPA multiview training
# Tests multiview with 3 text views + 2 audio views = 5 total views

include "cfg/debug/config_debug_lejepa.gin"

train.wandb_params = {
    "project": "text-audio",
    "name": "debug.lejepa.multiview.local",
    "offline": True,
    "save_dir": "./debug_logs/",
}

# Enable multiview
LeJEPA.n_text_views = 3

# Dummy data with 3 text views + 2 audio views
DummyTextAudioDataModule.n_text_views = 3
DummyTextAudioDataModule.n_audio_views = 2
