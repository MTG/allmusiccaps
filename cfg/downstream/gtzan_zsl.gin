dataset_name = "gtzan_zsl"
embeddings_dir = "/scratch/<group>/embeddings/"

# Lighting Trainer parameters, overwrites the training config
predict.params = {
	"accelerator": "gpu",
	"devices": 1,
}

predict.overlap_ratio = 1
predict.embeddings_dir = %embeddings_dir
predict.dataset_name = %dataset_name

# Audio Loader for embedding extraction
data.audio_embedding_datamodule.AudioEmbeddingDataModule.data_dir = "/scratch/<group>/downstream_datasets/gtzan/22kmono"
data.audio_embedding_datamodule.AudioEmbeddingDataModule.file_format = "wav"
data.audio_embedding_datamodule.AudioEmbeddingDataModule.new_freq = 24000
data.audio_embedding_datamodule.AudioEmbeddingDataModule.num_workers = 20
data.audio_embedding_datamodule.AudioEmbeddingDataModule.batch_size = 1024
data.audio_embedding_datamodule.AudioEmbeddingDataModule.overlap_ratio = 0.5
data.audio_embedding_datamodule.AudioEmbeddingDataModule.n_seconds = 10
data.audio_embedding_datamodule.AudioEmbeddingDataModule.last_chunk_ratio = 1.0
data.audio_embedding_datamodule.AudioEmbeddingDataModule.mono = True
data.audio_embedding_datamodule.AudioEmbeddingDataModule.half_precision = False


build_module_and_datamodule.dataset_name = %dataset_name
build_module_and_datamodule.embeddings_dir = %embeddings_dir
GTZANEmbeddingLoadingDataModule.filelist = "/home/<user>/data/gtzan/metadata/gtzan_filelist.txt"
GTZANEmbeddingLoadingDataModule.batch_size = 64
GTZANEmbeddingLoadingDataModule.num_workers = 0
GTZANEmbeddingLoadingDataModule.layer_aggregation = "none"
GTZANEmbeddingLoadingDataModule.granularity = "chunk"
GTZANEmbeddingLoadingDataModule.time_aggregation = "mean"

train_probe.train_params = {
    "accelerator": "gpu",
    "devices": 1,
    "log_every_n_steps": 50,
    "max_steps": 50000,
    "num_sanity_val_steps": 0,
    "check_val_every_n_epoch": 1,
}
