dataset_name = "mtg_jamendo"
embeddings_dir = "/scratch/<group>/embeddings/"
data_dir = "/scratch/<group>/downstream_datasets/mtg-jamendo/"
splits_dir = "/scratch/<group>/downstream_datasets/mtg-jamendo/splits/split-0"

# Lighting Trainer parameters, overwrites the training config
predict.params = {
	"accelerator": "gpu",
	"devices": 1,
}

predict.overlap_ratio = 0.5
predict.embeddings_dir = %embeddings_dir
predict.dataset_name = %dataset_name

# Audio Loader for embedding extraction
data.audio_embedding_datamodule.AudioEmbeddingDataModule.data_dir = %data_dir
data.audio_embedding_datamodule.AudioEmbeddingDataModule.file_format = "mp3"
data.audio_embedding_datamodule.AudioEmbeddingDataModule.new_freq = 24000
data.audio_embedding_datamodule.AudioEmbeddingDataModule.num_workers = 20
data.audio_embedding_datamodule.AudioEmbeddingDataModule.batch_size = 1024
data.audio_embedding_datamodule.AudioEmbeddingDataModule.overlap_ratio = 0.5
data.audio_embedding_datamodule.AudioEmbeddingDataModule.n_seconds = 10
data.audio_embedding_datamodule.AudioEmbeddingDataModule.last_chunk_ratio = 0.5
data.audio_embedding_datamodule.AudioEmbeddingDataModule.mono = True
data.audio_embedding_datamodule.AudioEmbeddingDataModule.half_precision = False

# Probe training configuration
train_probe.train_tsv = "/home/<user>/reps/clap-mtg/src/mtg-jamendo-dataset/data/splits/split-0/autotagging_instrument-train.tsv"
train_probe.val_tsv = "/home/<user>/reps/clap-mtg/src/mtg-jamendo-dataset/data/splits/split-0/autotagging_instrument-validation.tsv"
train_probe.test_tsv = "/home/<user>/reps/clap-mtg/src/mtg-jamendo-dataset/data/splits/split-0/autotagging_instrument-test.tsv"
train_probe.embeddings_dir = %embeddings_dir
train_probe.dataset_name = %dataset_name
train_probe.hidden_size = 512
train_probe.num_layers = 2
train_probe.dropout = 0.2
train_probe.lr = 1e-4
train_probe.batch_size = 32
train_probe.num_workers = 20
train_probe.train_params = {
	"accelerator": "gpu",
	"devices": 1,
	"max_steps": 20000,
	"log_every_n_steps": 50,
}
train_probe.warmup_steps = 2000
train_probe.eta_min = 1e-7
