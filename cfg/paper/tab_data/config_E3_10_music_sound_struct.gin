# E3.10: CLAP trained on music + sound + struct (MSD + r4 + FS + PSE + DT v2)
# New data naming convention:
#   music  = MSD + r4 (M4-RAG)
#   sound  = FS (Freesound) + PSE
#   struct = DT v2 (Discotube v2, LLM-structured descriptions)
#
# Using audio_type_token. No sigreg regularization.
# Logs layerwise geometric metrics and information imbalance.
#
# Uses the same DT v1 filelists as E3.9 (quotes) for a direct comparison of text style.
# Struct subset size = 222405 (same as DT v1).
#
# Dataset sizes: MSD = 403803, r4 = 243084, FS = 286083, PSE = 709536, struct subset = 222405
# Group weights: 40% music / 20% sound / 40% struct, balanced by size within groups:
#   music:  MSD=0.15, r4=0.25
#   sound:  FS=0.14,  PSE=0.06
#   struct: dtv2_subset=0.40

include "cfg/config_clap_mpnet_base_v2_ssl_mp_10s_small_clap_dt_msd_fs_pse_lr_5e-6.gin"

train.datamodule = @concat_text_audio

# Discotube v2 (struct) datamodule settings
DiscotubeStructuredTextAudioDataModule.batch_size = %batch_size
DiscotubeStructuredTextAudioDataModule.num_workers = 20
DiscotubeStructuredTextAudioDataModule.data_dir = "/scratch/<group>/mmaps_discotube/"
DiscotubeStructuredTextAudioDataModule.filelist_train = "/scratch/<group>/discotube/metadata/mmap_ids_train_rel"
DiscotubeStructuredTextAudioDataModule.filelist_val = "/scratch/<group>/discotube/metadata/mmap_ids_val_rel"
DiscotubeStructuredTextAudioDataModule.text_file = "/scratch/<group>/discotube/metadata/llama33_promptv3_captions.jsonl"
DiscotubeStructuredTextAudioDataModule.p = 0.2

# DT v2 dataset settings
DiscotubeStructuredTextAudioDataset.num_frames = 160000
DiscotubeStructuredTextAudioDataset.folder_structure_type = "bsc"
DiscotubeStructuredTextAudioDataset.use_audio_type_token = False

# M4-RAG (r4) datamodule settings
M4RAGTextAudioDataModule.batch_size = %batch_size
M4RAGTextAudioDataModule.data_dir = "/scratch/<group>/mmaps_discotube/"
M4RAGTextAudioDataModule.filelist_train = "/scratch/<group>/discotube/metadata/m4rag_splits/filelist_train.txt"
M4RAGTextAudioDataModule.filelist_val = "/scratch/<group>/discotube/metadata/m4rag_splits/filelist_val.txt"
M4RAGTextAudioDataModule.metadata_file = "/scratch/<group>/discotube/metadata/m4rag_splits/m4rag_metadata.jsonl"
M4RAGTextAudioDataModule.num_workers = 20
M4RAGTextAudioDataModule.text_fields = ["description", "background", "analysis", "scene"]

# Use audio type tokens
MSDTextAudioDataset.use_audio_type_token = True
M4RAGTextAudioDataset.use_audio_type_token = True
M4RAGTextAudioDataset.num_frames = 160000
FreesoundTextAudioDataset.use_audio_type_token = True
PSETextAudioDataset.use_audio_type_token = True

# ConcatTextAudioDataModule: MSD + r4 + FS + PSE + DT v2
ConcatTextAudioDataModule.datamodules = [
  @MSDTextAudioDataModule,
  @M4RAGTextAudioDataModule,
  @FreesoundTextAudioDataModule,
  @PSETextAudioDataModule,
  @DiscotubeStructuredTextAudioDataModule,
]

# 40% music (MSD + r4), 20% sound (FS + PSE), 40% struct (DT v2 subset)
# balanced by dataset size within groups; struct subset = 222405 (same as DT v1)
# MSD=403803, r4=243084, FS=286083, PSE=709536, struct subset=222405
ConcatTextAudioDataModule.ratios = [0.15, 0.25, 0.14, 0.06, 0.40]

# Layerwise geometric metrics and information imbalance
train.layerwise_metrics = True
train.info_imbalance = True

train.wandb_params = {
    "entity": "<anon-entity>",
    "group": "data_experiments",
    "name": "E3_10_music_sound_struct",
    "offline": True,
    "project": "text-audio",
    "save_dir": "/projects/<group>/logs/",
}
