# E7.1: CLAP using only layer 6 of the OMARRQ encoder.
# Data: music + sound + quotes (same as E3.9)
#   music  = MSD + r4 (M4-RAG)
#   sound  = FS (Freesound) + PSE
#   quotes = DT v1 (Discotube v1, sentence-level text)
#
# No audio_type_token. No sigreg regularization.
# Logs layerwise geometric metrics and information imbalance.

include "cfg/config_E3_9_music_sound_quotes.gin"

# Use only layer 6 of the encoder
OMARRQ.layers = (6,)

# Re-enable audio type tokens (overrides E3.9 which disables them)
DiscotubeTextAudioCleanDataset.use_audio_type_token = True
MSDTextAudioDataset.use_audio_type_token = True
M4RAGTextAudioDataset.use_audio_type_token = True
FreesoundTextAudioDataset.use_audio_type_token = True
PSETextAudioDataset.use_audio_type_token = True

train.wandb_params = {
    "entity": "<anon-entity>",
    "group": "layer_experiments",
    "name": "E7_1_layer6",
    "offline": True,
    "project": "text-audio",
    "save_dir": "/projects/<group>/logs/",
}
