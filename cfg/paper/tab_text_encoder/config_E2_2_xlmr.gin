# E2.2: CLAP with XLM-RoBERTa text encoder
# Based on config_clap_mpnet_base_v2_ssl_mp_10s_small_clap_dt_msd_fs_pse_lr_5e-6.gin
# with XLM-RoBERTa-base instead of all-mpnet-base-v2
#
# Key changes from baseline:
# - Text encoder: xlm-roberta-base (768-dim, multilingual)
# - Same audio encoder: OMARRQ
# - Same training data: concat (DiscoTube + MSD + Freesound + PSE)

include "cfg/config_clap_mpnet_base_v2_ssl_mp_10s_small_clap_dt_msd_fs_pse_lr_5e-6.gin"

# Override text encoder
CLAP.text_encoder = @XLMRobertaTextEncoder

# XLM-RoBERTa encoder settings
XLMRobertaTextEncoder.model_id = "xlm-roberta-base"
XLMRobertaTextEncoder.local_files_only = True

# Update wandb experiment name
train.wandb_params = {
    "entity": "<anon-entity>",
    "group": "encoder_experiments",
    "name": "E2_2_xlm_roberta_base",
    "offline": True,
    "project": "text-audio",
    "save_dir": "/projects/<group>/logs/",
}
